generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  passwordHash    String
  preferredLang   String    @default("en")
  tripPurpose     String    @default("leisure")
  dietaryPref     String?
  seatPreference  String?
  passportCountry String?
  paymentBalance  Float     @default(10000)
  travelProfile   String    @default("{}")
  isAdmin         Boolean   @default(false)
  
  // New fields for Disruption Concierge
  cardTier        String    @default("gold")
  phone           String?
  whatsappEnabled Boolean   @default(false)
  supabaseId      String?   @unique

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  trips           Trip[]
  expenses        Expense[]
}

model Feedback {
  id        String   @id @default(uuid())
  name      String?
  email     String?
  rating    Int
  message   String
  createdAt DateTime @default(now())
}

model Trip {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  destination    String
  startDate      DateTime
  endDate        DateTime
  status         String          @default("active")
  budget         Float           @default(0)
  budgetCurrency String          @default("INR")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  itinerary      ItineraryDay[]
  flights        FlightBooking[]
  hotels         HotelBooking[]
  cabs           CabBooking[]
  disruptions    Disruption[]
  notes          ItineraryNote[]

  @@index([userId])
  @@index([status])
}

model ItineraryDay {
  id              String   @id @default(uuid())
  tripId          String
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date            DateTime
  events          String   @default("[]")
  freeGaps        String   @default("[]")
  previousVersion String?
  weather         String?
  summary         String?
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tripId])
  @@index([date])
}

model FlightBooking {
  id               String   @id @default(uuid())
  tripId           String
  trip             Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  flightNumber     String
  origin           String
  destination      String
  departureTime    DateTime
  arrivalTime      DateTime
  airline          String
  status           String   @default("confirmed")
  price            Float    @default(0)
  seatClass        String   @default("economy")
  confirmationCode String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tripId])
  @@index([status])
}

model HotelBooking {
  id               String   @id @default(uuid())
  tripId           String
  trip             Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  hotelName        String
  checkIn          DateTime
  checkOut         DateTime
  confirmationCode String?
  status           String   @default("confirmed")
  latestCheckIn    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tripId])
}

model CabBooking {
  id         String   @id @default(uuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  pickup     String
  dropoff    String
  pickupTime DateTime
  status     String   @default("confirmed")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tripId])
}

model Expense {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  tripId      String?
  amount      Float
  currency    String   @default("USD")
  category    String
  description String
  receiptText String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([tripId])
}

model Disruption {
  id              String    @id @default(uuid())
  tripId          String
  flightId        String
  type            String
  status          String    @default("detected")
  detectedAt      DateTime  @default(now())
  confirmedAt     DateTime?
  source1         String
  source1Status   String
  source2         String
  source2Status   String
  resolution      String?
  trip            Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  alternatives    Alternative[]
  auditLog        AuditEntry[]

  @@index([tripId])
}

model Alternative {
  id              String    @id @default(uuid())
  disruptionId    String
  flightNumber    String
  airline         String
  origin          String
  destination     String
  departureTime   DateTime
  arrivalTime     DateTime
  price           Float
  currency        String    @default("INR")
  seatClass       String
  alliance        String?
  utilityScore    Float
  rank            Int
  excluded        Boolean   @default(false)
  exclusionReason String?
  holdStatus      String    @default("held")
  holdExpiresAt   DateTime
  createdAt       DateTime  @default(now())
  disruption      Disruption @relation(fields: [disruptionId], references: [id], onDelete: Cascade)

  @@index([disruptionId])
}

model AuditEntry {
  id              String    @id @default(uuid())
  disruptionId    String
  event           String
  detail          String
  metadata        String?
  timestamp       DateTime  @default(now())
  disruption      Disruption @relation(fields: [disruptionId], references: [id], onDelete: Cascade)

  @@index([disruptionId])
}

model ItineraryNote {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayId     String
  eventTime String
  note      String
  userId    String
  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([dayId])
}


model MemoryAtom {
  id         String   @id @default(uuid())
  userId     String
  agentName  String
  content    String
  embedding  String   @default("[]")
  tripId     String?
  confidence Float    @default(1.0)
  promotedTo String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([agentName])
}

model MemoryPattern {
  id                String   @id @default(uuid())
  userId            String
  agentName         String
  consolidatedClaim String
  claimEmbedding    String   @default("[]")
  supportingAtomIds String   @default("[]")
  timesUsed         Int      @default(0)
  confidence        Float    @default(0.0)
  lastValidatedAt   DateTime
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([agentName])
}
